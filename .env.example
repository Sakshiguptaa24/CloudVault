# CloudVault 2.0 – Intelligent Cloud Backup & Disaster Recovery Platform
# Environment Configuration

# ------------------------------------------------------------------------------
# Core Server & Network
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=True
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Keys
# ------------------------------------------------------------------------------
SECRET_KEY=cloudvault-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_MASTER_KEY_SALT=cloudvault-aes-gcm-master-salt-2026

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/cloudvault.db

# ------------------------------------------------------------------------------
# Multi-Cloud Storage Configuration
# Options: 'mock' (default, air-gapped zero-cost), 'gcs', 's3', 'azure'
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=mock

# Local Air-Gapped Mock Storage (Default)
MOCK_STORAGE_DIR=./data/mock_storage

# Google Cloud Storage (GCS)
GCS_BUCKET_NAME=cloudvault-production-backups
GCS_PROJECT_ID=my-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=config/gcp-service-account.json
GCS_REGION=us-central1
# Optional: Inline JSON credentials (for PaaS / container deployments)
# GCS_CREDENTIALS_JSON={"type": "service_account", ...}

# Amazon Web Services (AWS S3 Adapter)
AWS_S3_BUCKET=cloudvault-s3-backup
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Microsoft Azure Blob Storage Adapter
AZURE_CONTAINER=cloudvault-backups
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;

# ------------------------------------------------------------------------------
# AI Copilot & Anomaly Engine
# ------------------------------------------------------------------------------
AI_PROVIDER=local_rules  # 'local_rules' (deterministic offline semantic engine) or 'llm'
RANSOMWARE_ENTROPY_THRESHOLD=7.50
WORM_DEFAULT_LOCK_DAYS=14
